   "paths": {
    "/": {
     "get": {
      "summary": "Dados de Conta",
      "description": "Visualize os dados da conta que foi dada a autorização através desta API",
      "operationId": "dados-de-conta",
      "responses": {
       "200": {
        "description": "200",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{\n  \"agency\": \"0001\",\n  \"accountNumber\": \"1063135\",\n  \"accountDigit\": \"1\",\n  \"bankCode\": \"403\",\n  \"bankName\": \"Cora SCD\"\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "agency": {
             "type": "string",
             "example": "0001"
            },
            "accountNumber": {
             "type": "string",
             "example": "1063135"
            },
            "accountDigit": {
             "type": "string",
             "example": "1"
            },
            "bankCode": {
             "type": "string",
             "example": "403"
            },
            "bankName": {
             "type": "string",
             "example": "Cora SCD"
            }
           }
          }
         }
        }
       },
       "400": {
        "description": "400",
