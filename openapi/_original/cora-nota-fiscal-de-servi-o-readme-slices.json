 {
  "page": "https://developers.cora.com.br/reference/cadastro-do-emissor-de-nota-fiscal.md",
  "definition": {
   "openapi": "3.1.0",
   "info": {
    "title": "nota-fiscal-de-serviço",
    "version": "1.0"
   },
   "servers": [
    {
     "url": "https://api.stage.cora.com.br/fiscal-receipts"
    }
   ],
   "components": {
    "securitySchemes": {
     "sec0": {
      "type": "oauth2",
      "flows": {}
     }
    }
   },
   "security": [
    {
     "sec0": []
    }
   ],
   "paths": {
    "/issuer": {
     "post": {
      "summary": "Cadastro de cliente para emissão de NFS-e",
      "description": "Cadastre as informações iniciais obrigatórias para emissão de nota fiscal de serviço",
      "operationId": "cadastro-do-emissor-de-nota-fiscal",
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "required": [
           "municipal_register",
           "tax_regime",
           "special_tax_regime",
           "rps"
          ],
          "properties": {
           "municipal_register": {
            "type": "string",
            "description": "Inscrição municipal da empresa.",
            "default": "12345678"
           },
           "state_register": {
            "type": "string",
            "description": "Inscrição Estadual da empresa.",
            "default": "12345678"
           },
           "tax_regime": {
            "type": "string",
            "description": "Regime tributário da empresa",
            "default": "SIMPLES_NACIONAL"
           },
           "special_tax_regime": {
            "type": "string",
            "description": "Regime tributário especial da empresa. Caso não tenha, enviar \"NONE\"",
            "default": "NONE"
           },
           "rps": {
            "type": "object",
            "description": "Objeto RPS (série e número)",
            "required": [
             "serie",
             "last_number"
            ],
            "properties": {
             "serie": {
              "type": "string",
              "description": "Número de série do RPS. O padrão é \"1\",  mas tem cidades que aceitam letras como \"U\""
             },
             "last_number": {
              "type": "string",
              "description": "Último número de RPS utilizado."
             }
            }
           }
          }
         }
        }
       }
      },
      "responses": {
       "201": {
        "description": "201",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": ""
           }
          }
         }
        }
       },
       "400": {
        "description": "400",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{\n    \"code\": \"FRA-001\",\n    \"message\": \"Received malformed JSON for IssuerSetupRequestDTO\"\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "code": {
             "type": "string",
             "example": "FRA-001"
            },
            "message": {
             "type": "string",
             "example": "Received malformed JSON for IssuerSetupRequestDTO"
            }
           }
          }
         }
        }
       }
      }
     }
    }
   },
